# Public API base URL (no trailing slash). Required for Vercel + local.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (set in Vercel → Environment Variables):
# NEXT_PUBLIC_API_URL=https://scaler-assignment-route53-production.up.railway.app

# Amazon Q (server-only). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-20b — mid-tier speed/price)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=llama-3.1-8b-instant
